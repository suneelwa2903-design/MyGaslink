# Local dev — gitignored (.gitignore line 13). Created for physical-device testing.
# LAN IP of this machine's Wi-Fi adapter so Expo Go on a phone on the same
# network can reach the API. NOT localhost (phone can't resolve it).
# API binds 0.0.0.0 in dev. Metro's manifest confirmed hostUri=192.168.1.3:8081
# on 2026-07-15, so the API is at http://192.168.1.3:5000/api on the same NIC.
# IP changes with network/DHCP — if login times out, re-check via
# `ipconfig` (look for the IPv4 that matches Metro's hostUri).
EXPO_PUBLIC_API_URL=http://192.168.1.5:5000/api

EXPO_PUBLIC_SENTRY_DSN=
