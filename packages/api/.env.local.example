# ─── Local overrides (dev machine only) ─────────────────────────────────────
#
# This file is loaded AFTER .env with override:true — anything you set here
# replaces the tracked .env value for local development only.
#
# Copy this file to .env.local and drop in your personal test credentials.
# .env.local is gitignored and NEVER deployed to production.
#
# Typical use: run local quotation-send tests from a personal Gmail without
# touching the tracked info@mygaslink.com SMTP config that prod uses.

# ─── SMTP (personal Gmail for local testing) ────────────────────────────────
# 1. Sign in at accounts.google.com as your personal Gmail
# 2. Enable 2-Step Verification if not already on:
#      https://myaccount.google.com/security
# 3. Create an app password labelled "MyGasLink SMTP dev":
#      https://myaccount.google.com/apppasswords
# 4. Paste the 16-char password below (strip spaces)

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="mvsuneelkumar2903@gmail.com"
SMTP_PASS="paste-16-char-app-password-here-no-spaces"
SMTP_FROM="mvsuneelkumar2903@gmail.com"
SMTP_FROM_NAME="MyGasLink (dev)"
